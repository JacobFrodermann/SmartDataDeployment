# Copy to .env and adapt. Compose reads .env automatically from this directory.

# Compose project name. It is part of the database volume name
# (smartdatajobs_smartuser-db-data), so changing it starts a new empty database.
#COMPOSE_PROJECT_NAME=smartdatajobs

# Exposed ports.
#SMARTDATAJOBS_HTTP_PORT=8080
#SMARTDATAJOBS_ADMIN_PORT=4848

# Database used by SmartUser (schema smartuser) and, by default, SmartData
# (schemas public and smartmonitoring).
#SMARTUSER_DB_NAME=smartuser
#SMARTUSER_DB_USER=smartuser
#SMARTUSER_DB_PASSWORD=smartuser

# SmartData database; defaults to SMARTUSER_DB_NAME.
#SMARTDATA_DB_NAME=smartuser
