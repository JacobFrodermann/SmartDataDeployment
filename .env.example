# Copy to .env and adapt. Compose reads .env automatically from this directory.
#
# The database connection itself (host, port, database names, user) is hardcoded
# in compose.yaml on purpose: this stack deploys against the provided
# PostgreSQL server, and the target must not be redirected accidentally.

# Password of the provided server (user webengineering_group). Use SINGLE
# quotes: Compose interpolates $VAR inside double quotes and would silently
# drop parts of the password.
SMARTUSER_DB_PASSWORD='change-me'

# Compose project name.
#COMPOSE_PROJECT_NAME=smartdatajobs

# Exposed ports.
#SMARTDATAJOBS_HTTP_PORT=8080
#SMARTDATAJOBS_ADMIN_PORT=4848

# Swagger UI / API overview (read-only view of /openapi), see AGENTS.md §8.1.
#API_OVERVIEW_PORT=8099
